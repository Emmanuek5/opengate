{
  "name": "opengate",
  "version": "0.4.1",
  "description": "A coding agent for your AI gateway: an interactive terminal agent and an ACP agent for T3 Code, Zed and JetBrains, using any model your gateway offers.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opengate": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "acp": "bun src/cli.ts acp",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun scripts/build.ts",
    "smoke:acp": "bun scripts/acp-smoke.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.12.0",
    "@anthropic-ai/sdk": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cli-highlight": "^2.1.11",
    "ink": "^8.0.0",
    "openai": "^7.64.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.1",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
